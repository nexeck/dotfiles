#!/usr/bin/env fish

function update --description "Update"
    if command -qa brew
        brew update
        brew upgrade
    end
    if command -qa port
        sudo port selfupdate
        sudo port upgrade outdated
    end

    if command -qa tldr
        tldr --update
    end

    {{ if eq .chezmoi.os "darwin" -}}
    sudo softwareupdate --install --all
    {{ end }}
end
