[user]
	name = {{ protonPass "pass://Work/GIT Config/name" | trim }}
	email = {{ protonPass "pass://Work/GIT Config/email" | trim }}
	signingkey = {{ protonPass "pass://Work/GIT Config/signingkey" | trim }}

[core]
  # IdentitiesOnly instead of `-F /dev/null`: the latter would discard all of
  # ~/.ssh/config (IdentityAgent, ControlMaster, ServerAliveInterval, ...) for
  # every git connection, while still restricting git to this one key.
  sshCommand = "ssh -i ~/.ssh/id_ed25519_work.pub -o IdentitiesOnly=yes"

[commit]
	# https://help.github.com/articles/signing-commits-using-gpg/
	gpgsign = true

[gpg]
  format = ssh

[gpg "ssh"]
  allowedSignersFile = ~/.ssh/allowed_signers
