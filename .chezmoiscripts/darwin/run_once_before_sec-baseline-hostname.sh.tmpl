{{- if and (eq .chezmoi.os "darwin") .isPersonal -}}
#!/usr/bin/env bash

set -eufo pipefail

# Try to get serial number from ioreg
serial_number=$(ioreg -d2 -c IOPlatformExpertDevice | awk -F '"' '/IOPlatformSerialNumber/ { print $4 }')

# Fallback to system_profiler if ioreg is empty
if [ -z "${serial_number}" ]; then
    serial_number=$(system_profiler SPHardwareDataType | awk '/Serial/ { print $4 }' | head -n1)
fi

if [ -n "${serial_number}" ]; then
    # Derive the name from a truncated SHA-256 of the serial rather than the
    # serial itself: ComputerName/LocalHostName are broadcast over mDNS (and
    # the NetBIOS name over SMB), so using the raw serial would advertise a
    # unique, permanent hardware identifier to every network the machine joins.
    # The digest keeps the useful properties - stable across reboots/reinstalls
    # and unique per machine - without being reversible to the serial.
    machine_id=$(printf '%s' "${serial_number}" | shasum -a 256 | cut -c1-8)
    readonly hostname="MacOS-${machine_id}"

    sudo scutil --set ComputerName "${hostname}"
    sudo scutil --set HostName "${hostname}"
    sudo scutil --set LocalHostName "${hostname}"

    # NetBIOS name is limited to 15 uppercase characters
    readonly netbios_name=$(echo "${hostname:0:15}" | tr '[:lower:]' '[:upper:]')
    sudo defaults write /Library/Preferences/SystemConfiguration/com.apple.smb.server NetBIOSName -string "${netbios_name}"
else
    echo "Could not retrieve serial number. Hostname change skipped."
fi
{{- end -}}
