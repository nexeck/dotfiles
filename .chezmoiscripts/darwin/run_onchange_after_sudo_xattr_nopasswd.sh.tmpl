{{- if and (eq .chezmoi.os "darwin") .isWork -}}
#!/usr/bin/env bash

set -euo pipefail

# Install a root-owned wrapper that only removes quarantine attributes below
# Homebrew's bin and Caskroom directories, then allow admins to invoke only
# that wrapper without a password.
wrapper="/usr/local/libexec/dequarantine-homebrew"
sudoers_file="/etc/sudoers.d/xattr-dequarantine"
wrapper_tmp="$(mktemp)"
sudoers_tmp="$(mktemp)"
trap 'rm -f "$wrapper_tmp" "$sudoers_tmp"' EXIT

cat > "$wrapper_tmp" <<'EOF'
#!/bin/sh

set -eu

if [ "$#" -ne 1 ]; then
    echo "usage: dequarantine-homebrew PATH" >&2
    exit 64
fi

path=$1
case "$path" in
    *'/../'*|*'/./'*|*/..|*/.)
        echo "dequarantine-homebrew: path traversal is not allowed" >&2
        exit 65
        ;;
    /opt/homebrew/bin/*|/opt/homebrew/Caskroom/*) ;;
    *)
        echo "dequarantine-homebrew: path is outside allowed Homebrew directories" >&2
        exit 65
        ;;
esac

if [ ! -e "$path" ] && [ ! -L "$path" ]; then
    exit 0
fi

if [ -L "$path" ]; then
    /usr/bin/xattr -ds com.apple.quarantine "$path" 2>/dev/null || true
elif [ -d "$path" ]; then
    /usr/bin/xattr -drs com.apple.quarantine "$path" 2>/dev/null || true
else
    /usr/bin/xattr -ds com.apple.quarantine "$path" 2>/dev/null || true
fi
EOF

cat > "$sudoers_tmp" <<'EOF'
%admin ALL=(root) NOPASSWD: /usr/local/libexec/dequarantine-homebrew *
EOF

sudo install -d -m 0755 -o root -g wheel "$(dirname "$wrapper")"
if ! sudo cmp -s "$wrapper_tmp" "$wrapper" 2>/dev/null; then
    echo "Installing $wrapper..."
    sudo install -m 0755 -o root -g wheel "$wrapper_tmp" "$wrapper"
fi

if ! sudo cmp -s "$sudoers_tmp" "$sudoers_file" 2>/dev/null; then
    echo "Installing $sudoers_file..."
    sudo visudo -c -f "$sudoers_tmp"
    sudo install -m 0440 -o root -g wheel "$sudoers_tmp" "$sudoers_file"
fi
{{ end -}}
