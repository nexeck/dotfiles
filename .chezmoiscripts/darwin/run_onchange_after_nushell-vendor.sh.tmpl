{{- if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env bash

# depends on: {{ lookPath "nushell" | default "nushell" }} starship atuin zoxide mise git-town uv
# packages hash: {{ .packages.darwin.all.brews | toJson | sha256sum }}

set -eufo pipefail

NU_DATA_DIR="${HOME}/Library/Application Support/nushell"
VENDOR_DIR="${NU_DATA_DIR}/vendor/autoload"

mkdir -p "${VENDOR_DIR}"

if command -v starship >/dev/null 2>&1; then
    starship init nu > "${VENDOR_DIR}/starship.nu"
fi

if command -v atuin >/dev/null 2>&1; then
    atuin init nu > "${VENDOR_DIR}/atuin.nu"
fi

if command -v zoxide >/dev/null 2>&1; then
    zoxide init nushell --cmd cd > "${VENDOR_DIR}/zoxide.nu"
fi

if command -v mise >/dev/null 2>&1; then
    mise activate nu > "${VENDOR_DIR}/mise.nu"
fi

if command -v git-town >/dev/null 2>&1; then
    git-town completions nushell > "${VENDOR_DIR}/git-town.nu"
fi

if command -v uv >/dev/null 2>&1; then
    uv generate-shell-completion nushell > "${VENDOR_DIR}/uv.nu"
fi
{{ end -}}
