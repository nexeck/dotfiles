{{- if (eq .chezmoi.os "darwin") -}}
#!/usr/bin/env bash

set -eufo pipefail

# Re-run whenever macOS build changes (OS updates often reset PAM configurations):
# macOS Build: {{ output "sw_vers" "-buildVersion" | trim }}

# On macOS Sonoma (14.0) and newer, use /etc/pam.d/sudo_local to survive updates
if [ -f /etc/pam.d/sudo_local.template ]; then
    if [ ! -f /etc/pam.d/sudo_local ]; then
        echo "Creating /etc/pam.d/sudo_local from template..."
        sudo cp /etc/pam.d/sudo_local.template /etc/pam.d/sudo_local
    fi
    if ! grep -q "^auth[[:space:]]*sufficient[[:space:]]*pam_tid.so" /etc/pam.d/sudo_local; then
        echo "Enabling Touch ID in /etc/pam.d/sudo_local..."
        sudo sed -i '' 's/#auth[[:space:]]*sufficient[[:space:]]*pam_tid.so/auth       sufficient     pam_tid.so/' /etc/pam.d/sudo_local
    fi
else
    # Fallback for older macOS versions
    if ! grep -q "pam_tid" /etc/pam.d/sudo; then
        echo "Enabling Touch ID in /etc/pam.d/sudo..."
        sudo sh -s <<'ROOT'
set -eu
source=/etc/pam.d/sudo
tmp=$(mktemp /etc/pam.d/.sudo.XXXXXX)
trap 'rm -f "$tmp"' 0 HUP INT TERM
cp -p "$source" "$tmp"
{
    printf '%s\n' 'auth sufficient pam_tid.so'
    cat "$source"
} > "$tmp"
mv "$tmp" "$source"
ROOT
    fi
fi
{{ end -}}
