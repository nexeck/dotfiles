{{ if and (eq .chezmoi.os "darwin") -}}
#!/usr/bin/env bash

set -eufo pipefail

# authenticate the sudo session upfront so later sudo calls (e.g. port install) don't prompt mid-script
sudo -v

{{ $packagesTaps := list }}
{{ $packagesBrews := list }}
{{ $packagesCasks := list }}
{{ $packagesPorts := list }}
{{ $packagesVscode := list }}

{{- if hasKey .packages.darwin "all" -}}
    {{- if hasKey .packages.darwin.all "taps" -}}
        {{- $packagesTaps = concat $packagesTaps .packages.darwin.all.taps -}}
    {{- end -}}
    {{- if hasKey .packages.darwin.all "brews" -}}
        {{- $packagesBrews = concat $packagesBrews .packages.darwin.all.brews -}}
    {{- end -}}
    {{- if hasKey .packages.darwin.all "casks" -}}
        {{- $packagesCasks = concat $packagesCasks .packages.darwin.all.casks -}}
    {{- end -}}
    {{- if hasKey .packages.darwin.all "ports" -}}
        {{- $packagesPorts = concat $packagesPorts .packages.darwin.all.ports -}}
    {{- end -}}
{{- end -}}
{{- if and (hasKey .packages.vscode "all") .packages.vscode.all -}}
    {{- $packagesVscode = concat $packagesVscode .packages.vscode.all -}}
{{- end -}}

{{- if .isWork -}}
    {{- if hasKey .packages.darwin "work" -}}
        {{- if hasKey .packages.darwin.work "taps" -}}
            {{- $packagesTaps = concat $packagesTaps .packages.darwin.work.taps -}}
        {{- end -}}
        {{- if hasKey .packages.darwin.work "brews" -}}
            {{- $packagesBrews = concat $packagesBrews .packages.darwin.work.brews -}}
        {{- end -}}
        {{- if hasKey .packages.darwin.work "casks" -}}
            {{- $packagesCasks = concat $packagesCasks .packages.darwin.work.casks -}}
        {{- end -}}
        {{- if hasKey .packages.darwin.work "ports" -}}
            {{- $packagesPorts = concat $packagesPorts .packages.darwin.work.ports -}}
        {{- end -}}
    {{- end -}}
    {{- if hasKey .packages.vscode "work" -}}
        {{- $packagesVscode = concat $packagesVscode .packages.vscode.work -}}
    {{- end -}}
{{- end -}}
{{- if .isPersonal -}}
    {{- if hasKey .packages.darwin "personal" -}}
        {{- if hasKey .packages.darwin.personal "taps" -}}
            {{- $packagesTaps = concat $packagesTaps .packages.darwin.personal.taps -}}
        {{- end -}}
        {{- if hasKey .packages.darwin.personal "brews" -}}
            {{- $packagesBrews = concat $packagesBrews .packages.darwin.personal.brews -}}
        {{- end -}}
        {{- if hasKey .packages.darwin.personal "casks" -}}
            {{- $packagesCasks = concat $packagesCasks .packages.darwin.personal.casks -}}
        {{- end -}}
        {{- if hasKey .packages.darwin.personal "ports" -}}
            {{- $packagesPorts = concat $packagesPorts .packages.darwin.personal.ports -}}
        {{- end -}}
    {{- end -}}
    {{- if hasKey .packages.vscode "personal" -}}
        {{- $packagesVscode = concat $packagesVscode .packages.vscode.personal -}}
    {{- end -}}
{{- end -}}

# write the Brewfile to a temp file (rather than piping via /dev/stdin)
# so we can also feed it through dequarantine-watch below without having to
# duplicate this templated block.
brewfile=$(mktemp)
trap 'rm -f "$brewfile"' EXIT

cat > "$brewfile" <<EOF
{{ range $packagesTaps }}
{{- if kindIs "map" . -}}
tap {{ .name | quote }}, trusted: true{{ if hasKey . "url" }}, {{ .url | quote }}{{ end }}
{{ else -}}
tap {{ . | quote }}, trusted: true
{{ end }}
{{- end }}
{{ range $packagesBrews -}}
brew {{ . | quote }}
{{ end -}}
{{ range $packagesCasks -}}
cask {{ . | quote }}
{{ end -}}
{{ range $packagesVscode -}}
vscode {{ . | quote }}
{{ end -}}
EOF

# strip the com.apple.quarantine xattr from newly created files under
# /opt/homebrew/bin and /opt/homebrew/Caskroom while brew installs packages,
# so Gatekeeper doesn't block freshly installed binaries/apps. Only runs if
# dequarantine-watch is already deployed (it may not exist yet on a
# first-time bootstrap, before chezmoi has written ~/.local/bin).
if command -v dequarantine-watch >/dev/null 2>&1; then
    dequarantine-watch -w /opt/homebrew/bin -w /opt/homebrew/Caskroom -- brew bundle install --file="$brewfile"
else
    brew bundle install --file="$brewfile"
fi

{{ range $packagesPorts }}
#sudo port install -N {{ . }}
{{- end }}

{{ end -}}
