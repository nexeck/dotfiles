# Sourced by zsh for every interactive shell, login or not. .zprofile only
# runs for login shells, so a plain `zsh` started from another shell would
# otherwise get no PATH setup and no mise activation at all (bash already
# handles this via .bashrc). path.sh is idempotent within a single shell, so
# sourcing it here as well as from .zprofile is safe.
[ -r "$HOME/.config/shell/path.sh" ] && . "$HOME/.config/shell/path.sh"

# Prompt: mirrors dot_config/private_fish/conf.d/starship.fish. Lives in
# .zshrc rather than .zprofile because it is only meaningful for interactive
# shells, which is exactly when .zshrc is read.
command -v starship >/dev/null 2>&1 && eval "$(starship init zsh)"

function copilot-usage() {
    command copilot-usage "$@"
}

