#!/bin/sh
# Update everything: Homebrew, MacPorts, tldr pages and macOS itself.
#
# Lives here rather than as a fish function / nushell def so there is exactly
# one implementation. ~/.local/bin is on $PATH in fish, zsh, bash and nushell
# alike (see dot_config/shell/extra_paths.txt), so every shell just picks this
# up as a normal command.

set -eu

# Authenticate the sudo session upfront so later sudo calls don't prompt
# somewhere in the middle of a long run.
sudo -v

# Route brew through the dequarantine watcher when it is available. The fish
# `brew` function only wraps interactive fish, so without this every cask
# upgraded from here would keep its com.apple.quarantine xattr - exactly what
# the watcher exists to prevent.
brew_run() {
    if command -v brew-dequarantine-watch >/dev/null 2>&1 &&
        [ -x /usr/local/libexec/dequarantine-homebrew ]; then
        brew-dequarantine-watch \
            -w "${HOMEBREW_PREFIX:-/opt/homebrew}/bin" \
            -w "${HOMEBREW_PREFIX:-/opt/homebrew}/Caskroom" \
            -- brew "$@"
    else
        brew "$@"
    fi
}

if command -v brew >/dev/null 2>&1; then
    brew update
    brew_run upgrade
fi

if command -v port >/dev/null 2>&1; then
    sudo port selfupdate
    sudo port upgrade outdated
fi

if command -v tldr >/dev/null 2>&1; then
    tldr --update
fi
