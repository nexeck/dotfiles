#!/usr/bin/env bash
#
# brew-dequarantine-watch: run COMMAND while watching one or more paths for
# newly created files/directories and stripping the macOS com.apple.quarantine
# xattr from them as they appear. Written for wrapping Homebrew, which links
# unsigned/unnotarized binaries that Gatekeeper would otherwise block the first
# time they run.
#
# Usage:
#   brew-dequarantine-watch -w PATH [-w PATH ...] -- COMMAND [ARGS...]
#
# NOT a general-purpose tool despite the -w flag: the actual xattr removal is
# done by the root-owned helper /usr/local/libexec/dequarantine-homebrew (see
# .chezmoiscripts/darwin/run_onchange_after_sudo_xattr_nopasswd.sh.tmpl), which
# deliberately only accepts paths under /opt/homebrew/bin and
# /opt/homebrew/Caskroom. Watching anything else silently does nothing.
#
# Requires: watchexec, xattr (both macOS-only concerns). If either is
# missing, COMMAND is just run directly with no watching.

set -euo pipefail

watch_paths=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        -w)
            watch_paths+=("$2")
            shift 2
            ;;
        --)
            shift
            break
            ;;
        *)
            echo "brew-dequarantine-watch: unexpected argument: $1" >&2
            exit 64
            ;;
    esac
done

if [[ ${#watch_paths[@]} -eq 0 ]]; then
    echo "brew-dequarantine-watch: at least one -w PATH is required" >&2
    exit 64
fi

if [[ $# -eq 0 ]]; then
    echo "brew-dequarantine-watch: a command to run is required after --" >&2
    exit 64
fi

if ! command -v watchexec >/dev/null 2>&1 || ! command -v xattr >/dev/null 2>&1; then
    echo "brew-dequarantine-watch: watchexec and/or xattr not found, running command without dequarantine watching" >&2
    exec "$@"
fi

dequarantine_helper=/usr/local/libexec/dequarantine-homebrew
if [[ ! -x "$dequarantine_helper" ]]; then
    echo "brew-dequarantine-watch: $dequarantine_helper not found, running command without dequarantine watching" >&2
    exec "$@"
fi

# A throwaway directory that is watched alongside the real targets and used
# purely as a readiness canary: once the handler reports having seen a file
# created in here, watchexec's filesystem watches are demonstrably live.
# `pwd -P` resolves it through /var -> /private/var, so the path we pass to
# watchexec is the same physical path fsevents reports back.
probe_root=$(cd "$(mktemp -d)" && pwd -P)
probe_dir="$probe_root/watch"
ready_file="$probe_root/ready"   # deliberately outside probe_dir: it must not
                                 # itself generate events in the watched tree
mkdir -p "$probe_dir"
export DQ_READY_FILE="$ready_file"

# strip the quarantine xattr from every newly created file; recurse (-r) for
# directories (e.g. a Caskroom entry), without granting unrestricted xattr
# access through sudoers. Readiness-canary files are recognised by their
# distinctive basename rather than by their directory: macOS reports fs events
# under the resolved /private/var path, so matching on the temp directory
# prefix is unreliable. They are only acknowledged, never passed to the helper
# (which would reject them anyway, being outside the allowed Homebrew
# prefixes).
dequarantine_script='while IFS= read -r line; do f="${line#create:}"; case "${f##*/}" in .dq-probe-*) : > "$DQ_READY_FILE"; continue ;; esac; [ -e "$f" ] || [ -L "$f" ] || continue; sudo -n /usr/local/libexec/dequarantine-homebrew "$f"; done'

# --quiet: suppress watchexec's own "[Running: ...]" banners, which would
# otherwise be interleaved into the wrapped command's output.
watchexec_args=(--quiet --fs-events create --emit-events-to stdio --shell bash -w "$probe_dir")
for p in "${watch_paths[@]}"; do
    watchexec_args+=(-w "$p")
done

watchexec "${watchexec_args[@]}" -- "$dequarantine_script" &
watchexec_pid=$!

cleanup() {
    kill "$watchexec_pid" 2>/dev/null || true
    wait "$watchexec_pid" 2>/dev/null || true
    rm -rf "$probe_root"
}
trap cleanup EXIT

# Wait for the watches to actually be established before letting the wrapped
# command start creating files. A fixed `sleep 1` used to guess at this and
# genuinely lost the race sometimes: Homebrew executes freshly linked binaries
# immediately (e.g. to generate shell completions), and a still-quarantined
# binary executed non-interactively is SIGKILLed with no Gatekeeper prompt.
wait_for_watcher() {
    local deadline=$((SECONDS + 15))
    local n=0
    while ((SECONDS < deadline)); do
        : > "$probe_dir/.dq-probe-$((n++))"
        for _ in 1 2 3 4 5; do
            [[ -e "$ready_file" ]] && return 0
            sleep 0.1
        done
        # watcher died - no point polling until the deadline
        kill -0 "$watchexec_pid" 2>/dev/null || return 1
    done
    return 1
}

if ! wait_for_watcher; then
    echo "brew-dequarantine-watch: watcher did not become ready in time, continuing anyway" >&2
fi

"$@"
