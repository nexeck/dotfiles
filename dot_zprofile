# Sourced automatically by zsh for login shells, before .zshrc.
# PATH/env setup lives here (not .zshrc) so it's exported once per login
# session and inherited by every child shell/process.
[ -r "$HOME/.config/shell/path.sh" ] && . "$HOME/.config/shell/path.sh"

# Prompt: mirrors dot_config/private_fish/conf.d/starship.fish. Kept here
# (not .zshrc, which isn't chezmoi-managed) and guarded on interactivity so
# non-interactive login shells (e.g. `zsh -l script.sh`) skip it.
if [[ -o interactive ]] && command -v starship >/dev/null 2>&1; then
    eval "$(starship init zsh)"
fi
