{{- /* Privileges.app is optional, so render nothing at all when it is absent.
      When it IS installed, resolve its CLI via $PATH (the app ships an
      /etc/paths.d entry for /Applications/Privileges.app/Contents/MacOS) - but
      abort loudly instead of rendering an empty <string></string>, which would
      produce a plist launchd refuses to load. */ -}}
{{- if stat "/Applications/Privileges.app" -}}
{{- $privilegesCLI := lookPath "privilegesCLI" -}}
{{- if not $privilegesCLI }}{{ fail "privilegesCLI not found in $PATH - Privileges.app is installed, so its /etc/paths.d entry is missing" }}{{ end -}}
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.sap.privileges.renew</string>
    {{- /* Renew, then sleep a random 600-13200s (10-220 min) before the next
          KeepAlive restart. PrivilegesCLI --add grants admin access for 240
          minutes, leaving a 20-minute margin while spreading renewal load.
          The long-lived shell is intentionally transparent through its
          StandardOutPath/StandardErrorPath log. ThrottleInterval prevents a
          transient launchd or CLI failure from becoming a rapid restart loop.
          The CLI path is passed as $0 rather than interpolated into the shell
          string, so no quoting or escaping of the path is needed. RunAtLoad
          fires at login, and startup retries handle PrivilegesDaemon readiness.
          The retry loop always reaches the randomized sleep so persistent
          failures are retried on the next scheduled cycle rather than creating
          a hot loop. */}}
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>-c</string>
        <string>i=0; until "$0" --add || [ "$i" -ge 5 ]; do i=$((i + 1)); /bin/sleep 5; done; delay=$(/usr/bin/jot -r 1 600 13200 2>/dev/null); exec /bin/sleep "${delay:-3600}"</string>
        <string>{{ $privilegesCLI }}</string>
    </array>
    <key>KeepAlive</key>
    <true/>
    <key>RunAtLoad</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>60</integer>
    <key>StandardOutPath</key>
    <string>{{ .chezmoi.homeDir }}/Library/Logs/com.sap.privileges.renew.log</string>
    <key>StandardErrorPath</key>
    <string>{{ .chezmoi.homeDir }}/Library/Logs/com.sap.privileges.renew.log</string>
</dict>
</plist>
{{- end -}}
