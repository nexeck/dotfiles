{{- if and .isWork (stat "/Applications/Privileges.app") -}}
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.sap.privileges.renew</string>
    <key>ProgramArguments</key>
    <array>
        <string>{{ lookPath "privilegesCLI" }}</string>
        <string>--add</string>
    </array>
    <key>StartInterval</key>
    <integer>300</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/com.sap.privileges.renew.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/com.sap.privileges.renew.log</string>
</dict>
</plist>
{{- end -}}
