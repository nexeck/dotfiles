<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.proxy-certs</string>
    <!-- Make tools that ship their own CA bundle use the macOS keychain
         instead, so they trust the corporate TLS-intercepting proxy's root CA:
           NODE_USE_SYSTEM_CA  Node >= 22.15 / Electron, e.g. `code
                               --install-extension` run by `brew bundle`
           UV_SYSTEM_CERTS     uv >= 0.11 (UV_NATIVE_TLS is deprecated)
         `launchctl setenv` puts them into the GUI session environment, so every
         terminal, shell and app launched afterwards inherits them. One-shot:
         RunAtLoad without KeepAlive - setenv returns immediately. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>-c</string>
        <string>launchctl setenv NODE_USE_SYSTEM_CA 1; launchctl setenv UV_SYSTEM_CERTS true</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
</dict>
</plist>
