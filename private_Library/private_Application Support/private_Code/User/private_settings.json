{
  "workbench.colorCustomizations": {},
  "files.autoSave": "onFocusChange",
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit"
  },
  "terminal.integrated.copyOnSelection": true,
  "solidity.telemetry": false,
  "dataWrangler.enabledFileTypes": {
    "jsonl": true
  },
  "editor.formatOnPaste": true,
  "terminal.integrated.commandsToSkipShell": [
    "-workbench.action.quickOpenView"
  ],
  "mise.binPath": "mise",
  "go.toolsManagement.autoUpdate": true,
  "rust-analyzer.cargo.features": "all",
  "rust-analyzer.cargo.targetDir": true,
  "ruff.importStrategy": "fromEnvironment",
  "python.analysis.typeCheckingMode": "strict",
  "github.copilot.nextEditSuggestions.enabled": true,
  "terminal.integrated.stickyScroll.enabled": false,
  "chat.tools.urls.autoApprove": {
    "https://code.visualstudio.com": true,
    "https://github.com/microsoft/vscode/wiki/*": true,
    "https://github.com": {
      "approveRequest": false,
      "approveResponse": true
    }
  },
  "chat.mcp.gallery.enabled": true,
  "chat.tools.terminal.terminalProfile.osx": {
    "path": "bash"
  },
  "chat.assistedPermissions.enabled": true,
  "chat.agent.sandbox.enabled": "off",
  "chat.mcp.serverSampling": {
    "Global in Code: io.github.github/github-mcp-server": {
      "allowedModels": [
        "copilotcli/auto",
        "copilot/auto"
      ]
    }
  },
  "git.detectWorktrees": true,
  "git.autofetch": true,
  "foam.graph.onStartup": true,
  "foam.graph.navigateToPreview": true,
  "githubPullRequests.pullBranch": "never",
  "chat.agent.maxRequests": 100,
  "chat.agent.sandbox.fileSystem.linux": {
    "denyRead": [],
    "allowRead": [],
    "allowWrite": [],
    "denyWrite": []
  }
}